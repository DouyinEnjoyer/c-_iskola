<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="600">
    <Grid Margin="0,0,0,-16" HorizontalAlignment="Left" Width="600">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="37*"/>
            <ColumnDefinition Width="83*"/>
        </Grid.ColumnDefinitions>
        <Image HorizontalAlignment="Left" Source="./rover.jpg" Height="273" Margin="137,141,0,0" VerticalAlignment="Top" Width="346" RenderTransformOrigin="0.5,0.5" Grid.ColumnSpan="2">
            <Image.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform AngleX="-0.179" AngleY="0.001"/>
                    <RotateTransform/>
                    <TranslateTransform X="-0.5" Y="0.005"/>
                </TransformGroup>
            </Image.RenderTransform>
        </Image>
        <TextBlock HorizontalAlignment="Left" Height="18" x:Name="smok"  Margin="31,10,0,0" TextWrapping="Wrap" Text="TextBlock" VerticalAlignment="Top" Width="144"/>
        <TextBlock HorizontalAlignment="Left" Height="18" Margin="31,33,0,0" TextWrapping="Wrap" Text="TextBlock" VerticalAlignment="Top" Width="144"/>
        <Rectangle HorizontalAlignment="Left" x:Name="a" Height="21" Margin="154,7,0,0" Stroke="Black" VerticalAlignment="Top" Width="152" Grid.ColumnSpan="2"/>
        <Rectangle HorizontalAlignment="Left" Height="20" Margin="154,32,0,0" Stroke="Black" VerticalAlignment="Top" Width="152" Grid.ColumnSpan="2"/>
        <Button Content="Számitás" HorizontalAlignment="Left" Height="29" Margin="31,68,0,0" VerticalAlignment="Top" Width="96"/>
        <Button Content="Kapcsolodás" HorizontalAlignment="Left" Height="28" Margin="276,66,0,0" VerticalAlignment="Top" Width="95" Grid.Column="1"/>
        <Ellipse Fill="red" HorizontalAlignment="Left" Height="43" Margin="302,10,0,0" Stroke="Red" VerticalAlignment="Top" Width="43" Grid.Column="1" RenderTransformOrigin="-3.647,1.168"  />
        <TextBlock HorizontalAlignment="Left" Height="18" Margin="176,68,0,0" TextWrapping="Wrap" Text="TextBlock" VerticalAlignment="Top" Width="144" Grid.ColumnSpan="2"/>


    </Grid>
</Window>
